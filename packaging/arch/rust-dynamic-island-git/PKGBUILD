# Maintainer: nurexa <nurexas@gmail.com>
pkgname=rust-dynamic-island-git
_repo=Rust-Dynamic-Island
pkgver=r1
pkgrel=1
pkgdesc="All-in-one Wayland desktop shell in one Dynamic Island pill: bar, launcher, notifications, clipboard, screenshots (git)"
arch=(x86_64 aarch64)
url="https://github.com/nurexa/Rust-Dynamic-Island"
license=('GPL-3.0-only AND Apache-2.0')
depends=(cairo pango glib2 libxkbcommon gcc-libs glibc)
makedepends=(cargo git)
optdepends=(
  'pipewire-pulse: volume and per-app volume'
  'wireplumber: volume keys'
  'playerctl: media controls'
  'networkmanager: Wi-Fi'
  'bluez: Bluetooth'
  'upower: battery on laptops'
  'ddcutil: brightness for desktop monitors'
  'cliphist: clipboard history'
  'wl-clipboard: clipboard'
  'grim: screenshots'
  'slurp: region screenshots'
  'satty: annotating screenshots'
  'plocate: file search'
  'fd: file search without an index'
  'xdg-utils: opening files and links'
  'libnotify: notify-send for scripts'
  'adwaita-icon-theme: symbolic icons some tray apps ask for'
  'ttf-jetbrains-mono-nerd: app glyphs on the workspaces'
)
provides=(island rust-dynamic-island)
conflicts=(island rust-dynamic-island)
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_repo"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$_repo"
  install -Dm755 target/release/island "$pkgdir/usr/bin/island"
  # The installer wires the island into Mango: run /usr/share/island/install.sh.
  install -Dm755 install.sh "$pkgdir/usr/share/island/install.sh"
  install -Dm644 README.md MODDING.md -t "$pkgdir/usr/share/doc/island"
  install -Dm644 examples/config.toml "$pkgdir/usr/share/doc/island/config.toml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSES/Apache-2.0.txt "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0.txt"
}
